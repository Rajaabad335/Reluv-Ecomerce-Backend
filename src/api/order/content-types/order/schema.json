{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "buyer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "seller": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "productTitle": {
      "type": "string"
    },
    "productPrice": {
      "type": "decimal"
    },
    "productImage": {
      "type": "string"
    },
    "buyerProtectionFee": {
      "type": "decimal"
    },
    "shippingFee": {
      "type": "decimal"
    },
    "totalAmount": {
      "type": "decimal"
    },
    "deliveryMethod": {
      "type": "enumeration",
      "enum": ["pickup", "home"]
    },
    "address": {
      "type": "text"
    },
    "phoneNumber": {
      "type": "string"
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["pending", "paid", "failed", "refunded", "PAID", "REFUNDED", "FAILED"],
      "default": "pending"
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "placed",
        "in progress",
        "shipped",
        "delivered",
        "cancelled",
        "PENDING",
        "CONFIRMED",
        "PROCESSING",
        "SHIPPED",
        "DELIVERED",
        "CANCELLED"
      ],
      "default": "placed"
    },
    "deliveredAt": {
      "type": "datetime"
    },
    "disputeDeadline": {
      "type": "datetime"
    },
    "payoutEligibleAt": {
      "type": "datetime"
    },
    "disputeWindowStatus": {
      "type": "enumeration",
      "enum": ["OPEN", "CLOSED"],
      "default": "CLOSED"
    },
    "payoutStatus": {
      "type": "enumeration",
      "enum": [
        "NOT_ELIGIBLE",
        "ELIGIBLE",
        "ON_HOLD",
        "PROCESSING",
        "TRANSFERRED",
        "BANK_PAYOUT_PENDING",
        "PAID",
        "FAILED",
        "CANCELLED",
        "not_eligible",
        "eligible",
        "on_hold",
        "pending",
        "processing",
        "transferred",
        "paid",
        "success"
      ],
      "default": "NOT_ELIGIBLE"
    },
    "paymentIntentId": {
      "type": "string"
    },
    "chargeId": {
      "type": "string"
    },
    "stripeFee": {
      "type": "decimal"
    },
    "platformCommission": {
      "type": "decimal"
    },
    "sellerEarnings": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "thb"
    }
  }
}
