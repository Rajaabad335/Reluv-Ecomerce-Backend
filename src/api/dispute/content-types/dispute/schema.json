{
  "kind": "collectionType",
  "collectionName": "disputes",
  "info": {
    "singularName": "dispute",
    "pluralName": "disputes",
    "displayName": "dispute"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order"
    },
    "raisedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "recievedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "requestType": {
      "type": "enumeration",
      "enum": ["DISPUTE", "REFUND_REQUEST"],
      "default": "DISPUTE"
    },
    "reason": {
      "type": "enumeration",
      "enum": [
        "ITEM_NOT_RECEIVED",
        "DAMAGED_PRODUCT",
        "WRONG_ITEM",
        "PAYMENT_ISSUE",
        "PRODUCT_NOT_AS_DESCRIBED",
        "MISSING_ITEMS",
        "OTHER"
      ]
    },
    "description": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "OPEN",
        "UNDER_REVIEW",
        "AWAITING_INFORMATION",
        "RESOLVED_REFUND",
        "RESOLVED_RELEASE",
        "RESOLVED",
        "RESOLVED_REFUND",
        "RESOLVED_RELEASE",
        "REJECTED",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "refundStatus": {
      "type": "enumeration",
      "enum": [
        "NONE",
        "PENDING",
        "PROCESSING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "default": "NONE"
    },
    "stripeRefundId": {
      "type": "string"
    },
    "adminDecision": {
      "type": "string"
    },
    "resolution": {
      "type": "text"
    },
    "adminNotes": {
      "type": "text"
    },
    "evidence": {
      "type": "text"
    },
    "refundAmount": {
      "type": "decimal"
    },
    "resolvedAt": {
      "type": "datetime"
    }
  }
}
